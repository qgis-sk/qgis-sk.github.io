# QGIS Slovensko – registračná služba pre qgis.sk (Python na 127.0.0.1:8773, systemd: qgis-sk)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name qgis.geosupport.sk;

    ssl_certificate /etc/letsencrypt/live/geosupport.sk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/geosupport.sk/privkey.pem;

    client_max_body_size 32k;
    access_log off;   # žiadne záznamy s IP adresami registrujúcich

    location /api/ {
        limit_req zone=qgissk burst=200 nodelay;
        proxy_pass http://127.0.0.1:8773;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /admin {
        limit_req zone=qgissk burst=200 nodelay;
        proxy_pass http://127.0.0.1:8773;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location / {
        return 302 https://qgis.sk/;
    }
}
